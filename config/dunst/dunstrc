[global]
    monitor = 0
    follow = mouse
    width = 380
    height = (80, 220)
    origin = top-right
    offset = (12, 44)
    scale = 0
    notification_limit = 5

    gap_size = 8
    separator_height = 0
    padding = 12
    horizontal_padding = 14
    text_icon_padding = 12
    frame_width = 2
    corner_radius = 8
    frame_color = "#44301e"

    font = CaskaydiaMono NFP 11
    line_height = 2
    markup = full
    format = "<b>%s</b>\n<span foreground='#aab6c4'>%b</span>"
    alignment = left
    vertical_alignment = center
    ellipsize = middle
    ignore_newline = no
    show_age_threshold = 60
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes

    icon_position = left
    min_icon_size = 32
    max_icon_size = 48
    icon_corner_radius = 6

    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 0
    progress_bar_min_width = 160
    progress_bar_max_width = 320
    progress_bar_corner_radius = 4
    highlight = "#ffac32"

    mouse_left_click = do_action, close_current
    mouse_middle_click = close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#070605f4"
    foreground = "#e8ded1"
    frame_color = "#44301e"
    timeout = 4

[urgency_normal]
    background = "#12100df7"
    foreground = "#e8ded1"
    frame_color = "#c97824"
    timeout = 6

[urgency_critical]
    background = "#1c1010f7"
    foreground = "#ffffff"
    frame_color = "#ff5c57"
    timeout = 0
