#!/bin/bash
# Panel brightness + fixed warm tint.
# Brightness is the panel's own (DPCD) backlight; the Hyprland screen shader
# only adds the warm tint. (Software dimming was a workaround for flicker that
# turned out to be panel self-refresh, fixed by xe.enable_psr=0.)
#
# Usage: brightness up | down | set <1-100> | apply | get
#        brightness dim      (drop to 10% without changing the saved level)
#        brightness restore  (back to the saved level)
set -euo pipefail

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}"
state="$state_dir/brightness"
shader="$HOME/.config/hypr/shaders/warm-dim.frag"
min=1 max=100
tint="1.0, 0.72, 0.45" # warm: full red, less green, much less blue

mkdir -p "$state_dir" "$(dirname "$shader")"
level=$(cat "$state" 2>/dev/null || echo 60)
save=1

case "${1:-get}" in
    # Fine steps: 2% normally, 1% in the dim range where each step is most visible.
    up) level=$((level + (level < 20 ? 1 : 2))) ;;
    down) level=$((level - (level <= 20 ? 1 : 2))) ;;
    set) level=${2:?usage: brightness set <1-100>} ;;
    apply | restore) ;;
    dim) level=$((level < 10 ? level : 10)); save=0 ;;
    get) echo "$level"; exit 0 ;;
    *) echo "usage: brightness up|down|set N|apply|get|dim|restore" >&2; exit 2 ;;
esac
((level < min)) && level=$min
((level > max)) && level=$max
((save)) && echo "$level" >"$state"

# Only touch the backlight when it's actually different: a redundant write on
# wake (dpms on) made the panel flash a second time.
cur=$(brightnessctl -m | cut -d, -f4); cur=${cur%\%}
[[ $cur == "$level" ]] || brightnessctl -q set "${level}%"

# Warm tint only (no dimming). Rewritten on `apply` so the file always matches.
if [[ ${1:-} == apply ]] || ! grep -q "vec3($tint);" "$shader" 2>/dev/null; then
    cat >"$shader" <<EOF
#version 300 es
// Generated by ~/.local/bin/brightness — edit that script, not this file.
precision highp float;
in vec2 v_texcoord;
uniform sampler2D tex;
out vec4 fragColor;
void main() {
    vec4 c = texture(tex, v_texcoord);
    c.rgb *= vec3($tint);
    fragColor = c;
}
EOF
    # Re-set the shader so Hyprland recompiles it.
    hyprctl eval 'hl.config({ decoration = { screen_shader = "" } })' >/dev/null
    hyprctl eval "hl.config({ decoration = { screen_shader = \"$shader\" } })" >/dev/null
fi

