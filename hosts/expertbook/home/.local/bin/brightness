#!/bin/bash
# Software brightness for the OLED panel.
# The BOE NB140B91-M02 flickers on content changes whenever its own brightness
# is below 100%, so the panel stays at 100% and dimming happens in Hyprland's
# screen shader (together with the warm tint).
#
# Usage: brightness up | down | set <5-100> | apply | get
#        brightness dim      (idle: drop to 10% without changing the saved level)
#        brightness restore  (back to the saved level)
set -euo pipefail

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}"
state="$state_dir/brightness"
shader="$HOME/.config/hypr/shaders/warm-dim.frag"
step=5 min=5 max=100
tint="1.0, 0.72, 0.45" # warm: full red, less green, much less blue

mkdir -p "$state_dir" "$(dirname "$shader")"
level=$(cat "$state" 2>/dev/null || echo 60)
save=1

case "${1:-get}" in
    up) level=$((level + step)) ;;
    down) level=$((level - step)) ;;
    set) level=${2:?usage: brightness set <5-100>} ;;
    apply | restore) ;;
    dim) level=$((level < 10 ? level : 10)); save=0 ;;
    get) echo "$level"; exit 0 ;;
    *) echo "usage: brightness up|down|set N|apply|get|dim|restore" >&2; exit 2 ;;
esac
((level < min)) && level=$min
((level > max)) && level=$max
((save)) && echo "$level" >"$state"

# Panel at full brightness: lower panel levels flicker.
brightnessctl -q set 100% || true

factor=$(awk -v l="$level" 'BEGIN { printf "%.3f", l / 100 }')
cat >"$shader" <<EOF
#version 300 es
// Generated by ~/.local/bin/brightness — edit that script, not this file.
precision highp float;
in vec2 v_texcoord;
uniform sampler2D tex;
out vec4 fragColor;
void main() {
    vec4 c = texture(tex, v_texcoord);
    c.rgb *= vec3($tint) * $factor;
    fragColor = c;
}
EOF

# Re-set the shader so Hyprland recompiles it.
hyprctl eval 'hl.config({ decoration = { screen_shader = "" } })' >/dev/null
hyprctl eval "hl.config({ decoration = { screen_shader = \"$shader\" } })" >/dev/null

[[ ${1:-} == @(apply|dim|restore) ]] || hyprctl notify -1 800 "rgb(ffac32)" "Brightness ${level}%" >/dev/null 2>&1 || true
