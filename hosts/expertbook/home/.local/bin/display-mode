#!/bin/bash
# Switch how external screens (monitors, projectors) are used, like Win+P.
# Usage: display-mode [next|extend|mirror|external|internal]
#   next (Super+P, the F8 display key): Extend -> Mirror -> External only -> Laptop only -> Extend
set -euo pipefail

internal=eDP-1
# Connected outputs other than the laptop panel (including currently disabled ones).
mapfile -t externals < <(hyprctl monitors all -j | python3 -I -c '
import json, sys
for m in json.load(sys.stdin):
    if m["name"] != "eDP-1":
        print(m["name"])')

rule() { hyprctl eval "hl.monitor({ $1 })" >/dev/null; }
internal_on() { rule "output = \"$internal\", mode = \"preferred\", position = \"0x0\", scale = 2"; }

mode="${1:-next}"
[ "$mode" = menu ] && mode=next      # old name
if [ "$mode" = next ]; then
    if [ ${#externals[@]} -eq 0 ]; then
        notify-send -a Display "No external screen" "Plug in a monitor or projector first."
        exit 0
    fi
    # Work out the current mode from what Hyprland shows, then take the next one.
    cur=$(hyprctl monitors -j | python3 -I -c '
import json, sys
ms = json.load(sys.stdin)
names = [m["name"] for m in ms]
ext = [m for m in ms if m["name"] != "eDP-1" and not m["name"].startswith(("AGENT", "HEADLESS"))]
if "eDP-1" not in names: print("external")
elif not ext: print("internal")
elif any(str(m.get("mirrorOf", "none")) not in ("none", "") for m in ext): print("mirror")
else: print("extend")')
    case "$cur" in
        extend) mode=mirror ;;
        mirror) mode=external ;;
        external) mode=internal ;;
        *) mode=extend ;;
    esac
fi

case "$mode" in
    extend)
        internal_on
        for o in "${externals[@]}"; do
            rule "output = \"$o\", mode = \"preferred\", position = \"auto-right\", scale = \"auto\""
        done ;;
    mirror)
        internal_on
        for o in "${externals[@]}"; do
            rule "output = \"$o\", mode = \"preferred\", position = \"auto\", scale = \"auto\", mirror = \"$internal\""
        done ;;
    external)
        [ ${#externals[@]} -gt 0 ] || { notify-send -a Display "No external screen" ""; exit 1; }
        for o in "${externals[@]}"; do
            rule "output = \"$o\", mode = \"preferred\", position = \"auto\", scale = \"auto\""
        done
        rule "output = \"$internal\", disabled = true"
        # Safety: if the external screen goes away, bring the laptop panel back.
        setsid -f bash -c '
            while sleep 2; do
                names=$(hyprctl monitors -j | python3 -I -c "import json,sys; print(\" \".join(m[\"name\"] for m in json.load(sys.stdin)))")
                case " $names " in *" '"$internal"' "*) exit 0 ;; esac  # panel back on: done
                if [ -z "$names" ]; then
                    hyprctl eval "hl.monitor({ output = \"'"$internal"'\", mode = \"preferred\", position = \"0x0\", scale = 2 })"
                    exit 0
                fi
            done' >/dev/null 2>&1 ;;
    internal)
        internal_on
        for o in "${externals[@]}"; do rule "output = \"$o\", disabled = true"; done ;;
    *) echo "usage: display-mode [menu|extend|mirror|external|internal]" >&2; exit 2 ;;
esac

sleep 1; "$HOME/.local/bin/ws-layout"     # workspaces 6-10 follow the extended screen
label=$(case "$mode" in extend) echo Extend;; mirror) echo Mirror;; external) echo "External only";; internal) echo "Laptop only";; esac)
notify-send -a Display -h string:x-canonical-private-synchronous:display-mode "Display: $label" "Super+P again for the next mode: Extend, Mirror, External only, Laptop only"
