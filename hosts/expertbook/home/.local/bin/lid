#!/bin/bash
# Lid switch handler (bound in hyprland.lua):
#   lid close   lock, screen off now (not after the 5-min idle timer); on battery, also
#               pause every app that has a window (Discord, browser, editor...,
#               with all their helper processes) so they stop waking the CPU.
#               Terminals and the shell keep running, so a build or download in a
#               terminal carries on. Nothing is paused while audio is playing
#               (music, a call on headphones).
#   lid rest    the same without the lid: hypridle's 5-min idle screen-off. This is
#               the daytime stand-in for sleep, which hangs on this machine; at night
#               idle-hibernate takes over after 30 min.
#   lid open    thaw everything, screen on.
# Docked (an external monitor attached) closing the lid does nothing: you're using it.
set -u
state="${XDG_RUNTIME_DIR:-/tmp}/lid-frozen"

external_monitor() { hyprctl -j monitors 2>/dev/null | grep -q '"name": "\(DP\|HDMI\)'; }
on_battery() { ! "$HOME/.local/bin/on-ac"; }
audio_playing() { pactl list sink-inputs 2>/dev/null | grep -q 'Corked: no'; }
# Window owners (minus terminals) and all their descendants.
app_pids() {
    local roots; roots=$(hyprctl -j clients | jq -r '.[] | select(.class | test("^(kitty|foot|Alacritty|org.wezfurlong.wezterm)$") | not) | .pid' | sort -u)
    [ -n "$roots" ] || return 0
    ps -e -o pid=,ppid= | awk -v r="$roots" '
        BEGIN { n = split(r, a, "\n"); for (i = 1; i <= n; i++) keep[a[i]] = 1 }
        { par[$1] = $2; pids[NR] = $1 }
        END { for (i in pids) { p = pids[i]; q = p
                while (q > 1) { if (q in keep) { print p; break } q = par[q] } } }'
}
screen() { qs ipc call power screen "$1" >/dev/null 2>&1; }

rest() {
    hyprctl dispatch 'hl.dsp.dpms({action = "off"})' >/dev/null
    screen off
    if on_battery && ! audio_playing; then
        app_pids >> "$state"
        xargs -r kill -STOP < "$state" 2>/dev/null
    fi
}

case "${1:-}" in
close) external_monitor || { loginctl lock-session; rest; } ;;   # logind locks too (HandleLidSwitch=lock); this makes sure
rest)  rest ;;
open)
    if [ -e "$state" ]; then
        xargs -r kill -CONT < "$state" 2>/dev/null
        rm -f "$state"
    fi
    hyprctl dispatch 'hl.dsp.dpms({action = "on"})' >/dev/null
    screen on
    ;;
*) echo "usage: lid close|rest|open" >&2; exit 2 ;;
esac
