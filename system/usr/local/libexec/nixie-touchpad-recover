#!/usr/bin/env bash
set -euo pipefail

device="i2c-ASUE140D:00"
device_path="/sys/bus/i2c/devices/$device"
driver_path="/sys/bus/i2c/drivers/i2c_hid_acpi"
controller_path="/sys/devices/pci0000:00/0000:00:15.0/i2c_designware.0"
pci_path="/sys/devices/pci0000:00/0000:00:15.0"
controller_driver="/sys/bus/platform/drivers/i2c_designware"
controller="i2c_designware.0"
product_name=$(cat /sys/class/dmi/id/product_name 2>/dev/null || true)

if [[ $(id -u) -ne 0 ]]; then
    printf 'nixie-touchpad-recover must run as root\n' >&2
    exit 77
fi

if [[ $product_name != *UX3402ZA* ]]; then
    printf 'unsupported system for this touchpad recovery: %s\n' "$product_name" >&2
    exit 69
fi

exec 9>/run/lock/nixie-touchpad-recover.lock
flock -n 9 || exit 0

for path in \
    "$device_path" \
    "$driver_path/bind" \
    "$driver_path/unbind" \
    "$controller_path/power/control" \
    "$pci_path/power/control" \
    "$controller_driver/bind" \
    "$controller_driver/unbind"; do
    if [[ ! -e $path ]]; then
        logger -t nixie-touchpad-recover "required path is missing: $path"
        exit 1
    fi
done

device_is_bound() {
    [[ -L $device_path/driver ]]
}

wait_for_device() {
    for _ in {1..20}; do
        device_is_bound && return 0
        sleep 0.1
    done
    return 1
}

rebind_device() {
    if device_is_bound && ! printf '%s' "$device" >"$driver_path/unbind"; then
        return 1
    fi
    sleep 0.5
    printf '%s' "$device" >"$driver_path/bind"
}

reset_controller() {
    if [[ -L $controller_path/driver ]] && \
        ! printf '%s' "$controller" >"$controller_driver/unbind"; then
        return 1
    fi
    sleep 1
    printf '%s' "$controller" >"$controller_driver/bind"
}

# The PCI function and its DesignWare child serve only the built-in touchpad.
# Keeping both active avoids the runtime transition associated with corrupt HID
# reports on this UX3402ZA.
printf 'on' >"$pci_path/power/control"
printf 'on' >"$controller_path/power/control"

method="HID rebind"
if ! rebind_device || ! wait_for_device; then
    # An -EREMOTEIO or lost-arbitration failure means the I2C bus itself is
    # wedged. Re-probing only i2c_hid_acpi cannot recover that state, so reset
    # the dedicated controller and let it enumerate the ACPI child again.
    logger -t nixie-touchpad-recover \
        "$device rebind failed; resetting dedicated DesignWare controller"
    method="controller reset"
    if ! reset_controller || ! wait_for_device; then
        logger -t nixie-touchpad-recover \
            "failed to recover $device after DesignWare controller reset"
        exit 1
    fi
fi

printf 'on' >"$pci_path/power/control"
printf 'on' >"$controller_path/power/control"
logger -t nixie-touchpad-recover \
    "recovered $device with $method and disabled controller runtime suspend"
